<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright 2026 Davide Faconti
  SPDX-License-Identifier: MPL-2.0

  Layout template for the headless 3D screenshot harness. screenshot_3d.sh
  substitutes the @TOKENS@ and writes the result next to the fixture; the app's
  layout option expects the substituted file, never this .in template.

  Keep XML comments free of double hyphens: XML forbids them inside a comment,
  and QDomDocument rejects the whole layout with a parse error (which the app
  reports only through a modal warning, so it looks like "nothing happened").

  Tokens:
    @MCAP_PATH@       absolute path of the generated MCAP fixture
    @DATASET_SOURCE@  the fixture's file NAME — DataEngine's DatasetInfo::source_name
                      is the basename, and the scene dock re-resolves its layers by
                      that name (DatasetIds are a per-session load-order counter).

  Schema notes (see pj_app/src/MainWindow.cpp + pj_plotting/widget/src/PlotDocker.cpp):
    * <previouslyLoaded_Datafiles>/<fileInfo> drives the startup reload. The
      <plugin> child is what makes the load NON-INTERACTIVE: FileLoader sets
      skip_dialog only when BOTH the plugin ID and a config payload are present
      (MainWindow::loadLayoutFromPath), and the ID must equal the plugin's
      manifest "name" (FileLoader compares against RuntimeDataSourcePlugin::name).
    * A hint-eligible preset is handed to the plugin VERBATIM — FileLoader does
      not inject the path in that branch — so the CDATA config must carry its own
      "filepath", and it must agree with the fileInfo filename.
    * The dock tree is <tabbed_widget>/<Tab>/<Container>/<DockArea>. A DockArea
      child element other than <plot> is an object-widget dock whose tag is the
      factory "kind"; "scene3d" maps to Scene3DDockWidget (MainWindow::makeSceneDock).
    * <config_topic> binds the TF source (FrameTransforms creates no layer, so a
      <layer> element would be wrong for /tf); <layer> creates the point-cloud
      layer. object_type strings are sdk::name(BuiltinObjectType) values.
-->
<root format="PlotJuggler" pj4_version="3" binding="source">
  <tabbed_widget name="Main Window" parent="main_window">
    <Tab tab_name="3D" id="scene3d-harness-tab" containers="1">
      <Container>
        <DockArea id="scene3d-harness-dock" name="3D View">
          <scene3d version="1" fixed_frame_mode="explicit" fixed_frame="world" follow_frame="">
            <config_topic dataset_id="1" dataset_source="@DATASET_SOURCE@" topic_name="/tf"
                          object_type="kFrameTransforms"/>
            <layer dataset_id="1" dataset_source="@DATASET_SOURCE@" topic_name="/points"
                   object_type="kPointCloud" display_name="/points" visible="true"/>
            <layer dataset_id="1" dataset_source="@DATASET_SOURCE@" topic_name="/map"
                   object_type="kOccupancyGrid" display_name="/map" visible="true"/>
          </scene3d>
        </DockArea>
      </Container>
    </Tab>
    <currentTabIndex index="0"/>
  </tabbed_widget>
  <previouslyLoaded_Datafiles>
    <fileInfo filename="@MCAP_PATH@" prefix="" display_offset_ns="0" timeline_order="0">
      <plugin ID="MCAP Loader"><![CDATA[{"filepath":"@MCAP_PATH@","max_array_size":500,"clamp_large_arrays":true,"use_log_time":false,"use_header_timestamp":false,"selected_topics":["/tf","/points","/map"]}]]></plugin>
    </fileInfo>
  </previouslyLoaded_Datafiles>
</root>
